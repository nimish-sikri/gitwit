# Copy this file to .env and fill in your values
# Never commit .env — it contains secrets

# ── Language Model ────────────────────────────────────────────────
# Provider: anthropic | ollama
LLM_PROVIDER=anthropic

# Anthropic — required if LLM_PROVIDER=anthropic
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama — local models, no API key needed
# Run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2

# ── Embeddings ────────────────────────────────────────────────────
# Provider: voyage | ollama | openai
# voyage-code-2 gives the best code retrieval quality
EMBEDDING_PROVIDER=voyage

# Voyage AI — 50M free tokens, no credit card
# Sign up at voyageai.com
VOYAGE_API_KEY=pa-...

# Ollama — local, free (lower quality for code)
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI
OPENAI_API_KEY=sk-...

# ── GitHub ────────────────────────────────────────────────────────
# Personal access token — for private repo cloning + PR reviews
# Required scopes: repo (or public_repo for public only)
GITHUB_TOKEN=ghp_...

# Webhook secret — set the same value in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=choose-a-random-secret

# ── Bitbucket (Enterprise / Server) ──────────────────────────────
# For self-hosted Bitbucket Server/Data Center
BITBUCKET_USERNAME=your-username
BITBUCKET_APP_PASSWORD=your-http-access-token
BITBUCKET_SERVER_URL=https://bitbucket.yourcompany.com

# ── Database & Storage ────────────────────────────────────────────
# Local development
CHROMA_PERSIST_DIR=./data/chromadb
REPOS_DIR=./data/repos

# Docker / Production (uncomment and set CHROMA_HOST)
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=development

# CORS — comma-separated list of allowed frontend origins
# Production: change to your actual domain
ALLOWED_ORIGINS=http://localhost:3000

# Tuning
MAX_REPO_SIZE_MB=500
EMBEDDING_BATCH_SIZE=64
SEARCH_TOP_K=20
SEARCH_ALPHA=0.5
MAX_CHUNK_LINES=150
REVIEW_MAX_FILES=20
